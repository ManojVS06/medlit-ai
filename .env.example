# ============================================
# MedLit AI — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git.
# ============================================

# --- LLM Provider ---
# Options: "mock", "gemini", "ollama"
LLM_PROVIDER=mock

# Google Gemini API key (only needed if LLM_PROVIDER=gemini)
# Get one free at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Ollama base URL (only needed if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434

# --- PubMed / NCBI ---
# Optional but recommended: increases rate limit from 3 to 10 req/sec
# Register free at: https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=your-ncbi-api-key-here
NCBI_EMAIL=your-email@example.com
NCBI_TOOL=medlit-ai

# --- Database ---
# For development with SQLite (Milestones 1-5):
DATABASE_URL=sqlite+aiosqlite:///./medlit.db

# For PostgreSQL (Milestone 6+):
# DATABASE_URL=postgresql+asyncpg://medlit:password@localhost:5432/medlit_db

# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
